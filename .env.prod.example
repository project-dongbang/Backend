# ==========================================
# DongBang Production Environment Variables
# Copy to /home/ubuntu/dongbang/.env on EC2
# ==========================================

# Database Configuration (PostgreSQL 17)
POSTGRES_DB=dongbang
POSTGRES_USER=dongbang
POSTGRES_PASSWORD=your_secure_postgres_password_here

# JWT Authentication
JWT_SECRET=your_minimum_256_bit_long_random_jwt_secret_key_here
# 저장된 계좌번호 복호화에 사용하므로 배포 때마다 재생성하지 않습니다.
FEE_ACCOUNT_ENCRYPTION_KEY=your_separate_minimum_256_bit_fee_account_encryption_key_here
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_REDIRECT_URIS=https://your-service-domain

# OAuth Configuration (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URI=https://your-service-domain/api/v1/auth/oauth/google/callback

# OAuth Configuration (Kakao)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URI=https://your-service-domain/api/v1/auth/oauth/kakao/callback

# AWS S3 (EC2에는 access key 대신 S3 권한이 있는 IAM Role을 연결합니다.)
AWS_S3_ENABLED=true
AWS_S3_BUCKET=your-private-s3-bucket
AWS_REGION=ap-northeast-2
# EC2 운영 환경에서는 IAM Role을 사용하므로 Access Key를 설정하지 않습니다.
AWS_S3_ENDPOINT=
AWS_S3_CUSTOM_DOMAIN=https://your-cloudfront-domain
AWS_S3_URL_TTL=PT15M

# Receipt OCR (PaddleOCR + optional Gemini post-processing)
RECEIPT_OCR_URL=http://ocr:8000
GEMINI_API_KEY=

# HTTPS reverse proxy configuration
API_DOMAIN=api.your-domain.example
# API는 Caddy 뒤에서 localhost:8080으로만 노출
APP_PORT=8080
IMAGE_NAME=ghcr.io/project-dongbang/backend:latest
