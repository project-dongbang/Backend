# ==============================================================================
# DongBang Backend - Local Environment Template (.env.example)
#
# [안내]
# - 이 파일은 예시 템플릿입니다. 실제 비밀값은 여기에 적지 않습니다.
# - 사용법: 이 파일을 복사하여 .env 파일을 만들고 실제 비밀번호를 입력하세요.
#   cp .env.example .env
# - .env 파일은 .gitignore에 등록되어 있으므로 Git에 절대 커밋되지 않습니다.
# ==============================================================================

# 1. Docker PostgreSQL 설정
POSTGRES_DB=dongbang
POSTGRES_USER=dongbang
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# 2. Spring Boot 로컬 실행 설정
DB_URL=jdbc:postgresql://localhost:5432/dongbang
DB_USERNAME=dongbang
DB_PASSWORD=
PORT=8080
SPRING_PROFILES_ACTIVE=local

# 3. 외부 API / OAuth 시크릿 (필요 시 로컬 .env에만 입력)
# JWT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
