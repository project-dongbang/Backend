# ==============================================================================
# DongBang Backend - Local Environment Template (.env.example)
#
# [안내]
# - 아래 기본값은 로컬 개발 전용이며 운영 서버에서 사용하지 않습니다.
# - 사용법: 이 파일을 복사하여 .env 파일을 만드세요.
#   cp .env.example .env
# - .env 파일은 .gitignore에 등록되어 있으므로 Git에 절대 커밋되지 않습니다.
# ==============================================================================

# 1. Docker PostgreSQL 설정
POSTGRES_DB=dongbang
POSTGRES_USER=dongbang
POSTGRES_PASSWORD=dongbang_local_only
POSTGRES_PORT=5432

# 2. Spring Boot 로컬 실행 설정
DB_URL=jdbc:postgresql://localhost:5432/dongbang
DB_USERNAME=dongbang
DB_PASSWORD=dongbang_local_only
PORT=8080
SPRING_PROFILES_ACTIVE=local
LOCAL_UPLOAD_DIR=./build/local-uploads

# 3. 외부 API / OAuth 시크릿 (필요 시 로컬 .env에만 입력)
JWT_SECRET=local-dongbang-jwt-secret-change-if-shared
# 저장된 계좌번호 복호화에 사용하므로 운영 중에는 값을 변경하지 않습니다(32자 이상).
FEE_ACCOUNT_ENCRYPTION_KEY=local-fee-account-key-change-if-shared
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_REDIRECT_URIS=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URI=http://localhost:8080/api/v1/auth/oauth/google/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URI=http://localhost:8080/api/v1/auth/oauth/kakao/callback
KAKAO_SCOPE=

# 4. S3 (로컬에서는 기본적으로 비활성화)
AWS_S3_ENABLED=false
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
# 로컬에서 실제 S3를 테스트할 때만 개인별 개발용 IAM Access Key를 입력합니다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_URL_TTL=PT15M

# 5. Receipt OCR (Google Gemini AI)
RECEIPT_OCR_URL=http://localhost:8000
GEMINI_API_KEY=
